# BuildSphere AI Backend Configuration Example
PORT=8000
DATABASE_URL=sqlite:///./buildsphere.db
SECRET_KEY=buildsphere_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Docs & Workspace Integration (Optional)
GOOGLE_CLIENT_ID=NOT_CONFIGURED
GOOGLE_CLIENT_SECRET=NOT_CONFIGURED
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google
GOOGLE_DOCS_SCOPES=https://www.googleapis.com/auth/documents https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets
GOOGLE_API_KEY=NOT_CONFIGURED

# Industrial IoT / MQTT Gateway (Optional)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=buildsphere/sensors/#

# Revit Desktop / Autodesk API Gateway (Optional)
AUTODESK_APS_CLIENT_ID=NOT_CONFIGURED
AUTODESK_APS_CLIENT_SECRET=NOT_CONFIGURED
REVIT_CONNECTOR_URL=http://localhost:8080/revit
